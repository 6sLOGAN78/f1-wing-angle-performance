    "aero.reference_area_m2": {"unit": "m^2", "classification": "assumed", "description": "Common force-coefficient reference area for the complete car.", "supported_range": [1.2, 1.8]},
    "aero.wing_area_m2": {"unit": "m^2", "classification": "derived", "description": "Planform reference area of the simplified rear wing.", "supported_range": [0.5, 0.9]},
    "aero.stall_angle_deg": {"unit": "deg", "classification": "assumed", "description": "Effective angle at the onset of the smooth post-stall model.", "supported_range": [15, 22]},
    "aero.baseline_cl": {"unit": "dimensionless", "classification": "assumed", "description": "Non-rear-wing full-car downforce coefficient magnitude.", "supported_range": [1.5, 3.5]},
    "aero.baseline_cd": {"unit": "dimensionless", "classification": "assumed", "description": "Non-rear-wing full-car drag coefficient.", "supported_range": [0.6, 1.1]},
    "tyres.mu_lateral_ref": {"unit": "dimensionless", "classification": "assumed", "description": "Reference lateral friction coefficient before load sensitivity.", "supported_range": [1.5, 2.2]},
    "powertrain.torque_nm": {"unit": "N m", "classification": "assumed", "description": "Representative engine torque curve used for comparative simulations.", "supported_range": [450, 650]},
    "solver.track_spacing_m": {"unit": "m", "classification": "derived", "description": "Maximum spatial step for circuit discretization.", "supported_range": [1, 5]}
  }
}

