  "parameter_register": {
    "vehicle.mass_kg": {"unit": "kg", "classification": "reference-informed", "description": "Representative car-plus-driver mass used throughout the comparison.", "supported_range": [740, 900]},
    "vehicle.wheelbase_m": {"unit": "m", "classification": "assumed", "description": "Representative wheelbase for load transfer and aero application geometry.", "supported_range": [3.2, 3.8]},
    "vehicle.cg_height_m": {"unit": "m", "classification": "assumed", "description": "Centre-of-gravity height used for longitudinal load transfer.", "supported_range": [0.25, 0.4]},
